# Copy to .env and fill in. Names only here, never values.
NODE_ENV=
PORT=
LOG_LEVEL=
# Origin the client is served from. Required: CORS is configured against it.
CLIENT_ORIGIN=
# postgres:// or postgresql://, and must name a database. The app's runtime role,
# which is deliberately not a superuser so row-level security stays honest.
DATABASE_URL=
# Set to true only while investigating abuse. IP addresses are personal data.
LOG_CLIENT_IP=
# Used by the server's integration tests. A separate database from the one you develop against.
TEST_DATABASE_URL=
# Model access. Required for OCR in F004; a dry run needs neither.
OPENAI_API_KEY=
# Vision-capable model that reads rendered pages.
OPENAI_VISION_MODEL=
# Optional. Without both, cost is reported as unknown rather than guessed,
# because a stale hard-coded price reads like a measurement.
OPENAI_VISION_INPUT_PER_MTOK=
OPENAI_VISION_OUTPUT_PER_MTOK=
